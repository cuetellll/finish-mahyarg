# Mahyar Gap — copy to .env and fill in private values. Never commit .env.
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_ACCESS_SECRET=replace-with-a-random-value-of-at-least-32-characters
BCRYPT_ROUNDS=12

# LiveKit (server-side only; never exposed to the browser)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ---------------------------------------------------------------------------
# RAILWAY STORAGE BUCKET — the ONLY object storage provider for this project.
#
# Create one private Bucket named `mahyar-music` in the Railway dashboard, then
# copy the values from the Bucket's **Credentials** tab. The cleanest setup is a
# Railway Variable Reference from the web service to the bucket service, using
# exactly these names (Railway writes them itself).
#
#   AWS_ENDPOINT_URL       https://<bucket-endpoint>      (from Credentials)
#   AWS_ACCESS_KEY_ID      <access key>                   (from Credentials)
#   AWS_SECRET_ACCESS_KEY  <secret key>                   (from Credentials)
#   AWS_S3_BUCKET_NAME     <S3 bucket identifier>         (from Credentials!)
#   AWS_DEFAULT_REGION     <bucket region>                (from Credentials)
#   AWS_S3_URL_STYLE       virtual-hosted | path          (from Credentials)
#
# IMPORTANT
#  • AWS_S3_BUCKET_NAME is the S3 bucket IDENTIFIER, not the `mahyar-music`
#    display name shown in the dashboard. Using the display name returns
#    NoSuchBucket.
#  • Railway Buckets default to virtual-hosted-style URLs, so the app runs with
#    forcePathStyle: false. Only set AWS_S3_URL_STYLE=path when the Credentials
#    tab shows path-style addressing.
#  • The bucket stays PRIVATE. Downloads are short-lived presigned URLs issued
#    server-side; no access key ever reaches browser JavaScript.
#  • The browser uploads audio directly with a presigned PUT, so the bucket needs
#    a CORS rule for <your app origin>: methods PUT/GET/HEAD, headers *, expose
#    ETag. Railway has no dashboard toggle — write it with:
#      npm run bucket:cors -- --apply https://<your-app> [http://localhost:3000]
#    and check it with `npm run bucket:cors -- --check --origin https://<your-app>`.
#
# Without these variables music uploads and attachments answer an honest 501
# with the exact missing variable names — nothing is simulated.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Mahyar Music. Active whenever LiveKit + the bucket are configured.
# Each active voice room gets one short-lived worker process
# (node dist/server/music/worker-main.js) that publishes the bot's audio track;
# it exits automatically when the room empties or playback stops.
#
# The ONLY playback source is the shared per-server music library (files your
# members upload). There is no link/URL playback and no external provider.
#
# Library limits (all optional, tuned for ~5 people on Railway Free):
#   Max size per uploaded audio file, MB.               MUSIC_MAX_FILE_MB=25
#   Storage quota per server, MB.                       MUSIC_SERVER_QUOTA_MB=500
#   Max track duration, seconds.                        MUSIC_MAX_DURATION_SEC=1800
#   Max tracks per server library.                      MUSIC_MAX_TRACKS=500
#   Max tracks waiting in one room's queue.             MUSIC_MAX_QUEUE=50
#
# Supported audio formats (validated by content, not just the extension):
#   mp3 (primary), m4a, aac, ogg, opus, wav, flac.
#
# Per-server music toggle: PATCH /api/servers/:id/music { music_enabled } by the
# owner / MANAGE_SERVER. Optional role nodes: MUSIC_UPLOAD and MUSIC_MANAGE —
# both default open so everyone can upload, play and control playback.
# ffmpeg must exist in the deployment image (Dockerfile installs it).
# ---------------------------------------------------------------------------

# Optional: exact public origin when the browser is served from another origin.
# CORS_ORIGIN=https://your-app.example.com
PORT=3000
